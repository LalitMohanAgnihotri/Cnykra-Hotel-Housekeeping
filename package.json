{
  "name": "cnykra-housekeeping-os",
  "version": "1.0.0",
  "description": "Hotel Housekeeping Operations System - MERN Stack",
  "scripts": {
    "server": "node server/server.js",
    "client": "cd client && npm run dev",
    "seed": "node server/seed.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install-all": "npm install && cd client && npm install"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^10.0.0",
    "mongoose": "^8.6.0"
  }
}
